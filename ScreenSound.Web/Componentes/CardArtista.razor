@inject IConfiguration Configuration

<MudCard>
    <MudCardMedia Image="@Imagem"></MudCardMedia>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Artista!.Nome</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudText Typo="Typo.body2">@Artista!.Bio</MudText>
        <MudRating SelectedValue="@Convert.ToInt32(Artista!.Classificacao)" ReadOnly />
    </MudCardContent>
    <MudCardActions>
        <MudButton Color="Color.Warning"
                   Variant="Variant.Outlined"
                   Href=@($"/EditarArtista/{Artista!.Nome}")>Detalhes</MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter]
    public ArtistaResponse? Artista { get; set; }

    public string? Imagem { get; set; }

    protected override void OnInitialized()
    {
        var apiUrl = Configuration["APIServer:Url"];

        if (!string.IsNullOrEmpty(Artista?.FotoPerfil) && Artista.FotoPerfil.StartsWith("/"))
        {
            Imagem = $"{apiUrl}{Artista.FotoPerfil}";
        }
        else
        {
            Imagem = "images/cardArtista.png";
        }
    }
}
