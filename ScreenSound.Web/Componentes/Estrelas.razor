<div class="ss-estrelas @(Grande ? "grande" : null)" title="@Titulo" role="@(Editavel ? "radiogroup" : "img")" aria-label="@Titulo">
    @for (var i = 1; i <= 5; i++)
    {
        var nota = i;
        var ligada = nota <= (hover ?? escolhido ?? Math.Round(Valor));
        if (Editavel)
        {
            <button type="button" class="@(ligada ? "on" : null)" aria-label="@($"{nota} de 5")"
                    @onclick="() => Selecionar(nota)" @onmouseenter="() => hover = nota" @onmouseleave="() => hover = null">
                <Icone Svg="@Icons.Material.Filled.Star" />
            </button>
        }
        else
        {
            <span class="@(ligada ? "on" : null)"><Icone Svg="@Icons.Material.Filled.Star" /></span>
        }
    }
</div>

@code {
    [Parameter] public double Valor { get; set; }
    [Parameter] public bool Editavel { get; set; }
    [Parameter] public bool Grande { get; set; }
    [Parameter] public EventCallback<int> OnAvaliar { get; set; }

    private int? hover;
    private int? escolhido;

    private string Titulo => Editavel ? "Avaliar" : $"Avaliação {Valor.ToString("0.0", CultureInfo.InvariantCulture)} de 5";

    private async Task Selecionar(int nota)
    {
        escolhido = nota;
        await OnAvaliar.InvokeAsync(nota);
    }
}
