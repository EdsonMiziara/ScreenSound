@page "/EditarMusica/{NomeMusica}"
@attribute [Authorize(Roles = Perfis.Administrador)]
@inject MusicaAPI MusicaAPI

<PageTitle>Editar faixa · ScreenSound</PageTitle>

<div class="ss-container ss-pagina">
    @if (carregando)
    {
        <SkeletonFaixas Quantidade="1" />
    }
    else if (musica is null)
    {
        <EstadoVazio Icone="@Icons.Material.Filled.SearchOff" Titulo="Faixa não encontrada" Texto="Ela pode ter sido removida ou renomeada.">
            <a href="/Musicas" class="ss-btn ss-btn-primario">Ver todas as faixas</a>
        </EstadoVazio>
    }
    else
    {
        <FormularioMusica @key="musica.Id" Musica="musica" />
    }
</div>

@code {
    [Parameter] public string NomeMusica { get; set; } = string.Empty;

    private MusicaResponse? musica;
    private bool carregando = true;

    protected override async Task OnParametersSetAsync()
    {
        carregando = true;
        try
        {
            musica = await MusicaAPI.GetMusicaPorNomeAsync(NomeMusica);
        }
        catch (HttpRequestException)
        {
            musica = null;
        }
        carregando = false;
    }
}
