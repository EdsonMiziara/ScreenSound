@page "/EditarArtista/{NomeArtista}"
@attribute [Authorize(Roles = Perfis.Administrador)]
@inject ArtistaAPI ArtistaAPI

<PageTitle>Editar artista · ScreenSound</PageTitle>

<div class="ss-container ss-pagina">
    @if (carregando)
    {
        <SkeletonFaixas Quantidade="1" />
    }
    else if (artista is null)
    {
        <EstadoVazio Icone="@Icons.Material.Filled.PersonOff" Titulo="Artista não encontrado" Texto="Ele pode ter sido removido ou renomeado.">
            <a href="/Artistas" class="ss-btn ss-btn-primario">Ver artistas</a>
        </EstadoVazio>
    }
    else
    {
        <FormularioArtista @key="artista.Id" Artista="artista" />
    }
</div>

@code {
    [Parameter] public string NomeArtista { get; set; } = string.Empty;

    private ArtistaResponse? artista;
    private bool carregando = true;

    protected override async Task OnParametersSetAsync()
    {
        carregando = true;
        try
        {
            artista = await ArtistaAPI.GetArtistaPorNomeAsync(NomeArtista);
        }
        catch (HttpRequestException)
        {
            artista = null;
        }
        carregando = false;
    }
}
