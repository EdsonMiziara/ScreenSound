@page "/Artistas"
@inject ArtistaAPI ArtistaAPI
@inject MusicaAPI MusicaAPI

<PageTitle>Artistas · ScreenSound</PageTitle>

<div class="ss-container ss-pagina">
    <div class="ss-cab-pagina">
        <div>
            <h1 class="ss-titulo-pagina">Artistas</h1>
            <p class="ss-secao-sub">
                @if (artistas is not null)
                {
                    @Visual.Plural(artistas.Count, "artista cadastrado", "artistas cadastrados")
                }
            </p>
        </div>
        <SomenteAdmin>
            <a class="ss-btn ss-btn-primario" href="/CadastrarArtista">
                <Icone Svg="@Icons.Material.Filled.PersonAdd" /> Novo artista
            </a>
        </SomenteAdmin>
    </div>

    <div class="ss-toolbar">
        <div class="ss-campo-busca">
            <Icone Svg="@Icons.Material.Filled.FilterList" />
            <input class="ss-campo" type="search" placeholder="Filtrar artistas" aria-label="Filtrar artistas"
                   @bind="filtro" @bind:event="oninput" />
        </div>
        <select class="ss-campo" aria-label="Ordenar por" @bind="ordem">
            <option value="az">Nome (A–Z)</option>
            <option value="avaliacao">Melhor avaliados</option>
            <option value="faixas">Mais faixas</option>
            <option value="recentes">Mais recentes</option>
        </select>
    </div>

    @if (artistas is null)
    {
        <div class="ss-grade">
            @for (var i = 0; i < 10; i++)
            {
                <div><div class="ss-skeleton" style="aspect-ratio:1;border-radius:50%"></div></div>
            }
        </div>
    }
    else if (artistas.Count == 0)
    {
        <EstadoVazio Icone="@Icons.Material.Filled.PersonOff" Titulo="Nenhum artista ainda" Texto="Os artistas cadastrados pela administração aparecem aqui.">
            <SomenteAdmin><a href="/CadastrarArtista" class="ss-btn ss-btn-primario">Novo artista</a></SomenteAdmin>
        </EstadoVazio>
    }
    else if (!Filtrados.Any())
    {
        <EstadoVazio Icone="@Icons.Material.Filled.SearchOff" Titulo="Nenhum artista encontrado" Texto="Tente buscar por outro nome." />
    }
    else
    {
        <div class="ss-grade">
            @foreach (var artista in Filtrados)
            {
                <ArtistaCard @key="artista.Id" Artista="artista" TotalFaixas="@FaixasDo(artista.Id)" />
            }
        </div>
    }
</div>

@code {
    private List<ArtistaResponse>? artistas;
    private ICollection<MusicaResponse> musicas = new List<MusicaResponse>();
    private string? filtro;
    private string ordem = "az";

    private IEnumerable<ArtistaResponse> Filtrados
    {
        get
        {
            var consulta = (artistas ?? new()).AsEnumerable();
            if (!string.IsNullOrWhiteSpace(filtro))
            {
                consulta = consulta.Where(a => Visual.Contem(a.Nome, filtro.Trim()));
            }

            return ordem switch
            {
                "avaliacao" => consulta.OrderByDescending(a => a.Classificacao ?? 0),
                "faixas" => consulta.OrderByDescending(a => FaixasDo(a.Id)),
                "recentes" => consulta.OrderByDescending(a => a.Id),
                _ => consulta.OrderBy(a => a.Nome, StringComparer.CurrentCultureIgnoreCase)
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var tarefaMusicas = MusicaAPI.GetMusicasAsync();
        artistas = (await ArtistaAPI.GetArtistasAsync())?.ToList() ?? new();
        musicas = await tarefaMusicas;
    }

    private int FaixasDo(int artistaId) => musicas.Count(m => m.ArtistaId == artistaId);
}
